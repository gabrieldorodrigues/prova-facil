# Cole sua chave do Google AI Studio (https://aistudio.google.com/apikey)
# Variáveis prefixadas com EXPO_PUBLIC_ ficam embutidas no bundle.
# OK para MVP/desenvolvimento. Para publicar na App Store, mover a chamada para um backend proxy.
EXPO_PUBLIC_GEMINI_API_KEY=

# Opcional: trocar o modelo se necessário (default: gemini-3.1-flash-lite)
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.1-flash-lite
